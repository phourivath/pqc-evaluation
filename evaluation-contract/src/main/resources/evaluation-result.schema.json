{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pqc-evaluation.dev/schema/evaluation-result-1.json",
  "title": "PQC Evaluation Result",
  "type": "object",
  "required": ["schemaVersion", "runId", "generatedAt", "implementation", "runtime", "parameterSets", "checks", "interoperability", "warnings"],
  "properties": {
    "schemaVersion": {"enum": ["1.0", "1.1"]},
    "runId": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "implementation": {"$ref": "#/$defs/implementation"},
    "runtime": {"type": "object"},
    "parameterSets": {"type": "array", "items": {"$ref": "#/$defs/parameterSet"}},
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "interoperability": {"type": "array", "items": {"$ref": "#/$defs/interop"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "oneOf": [
    {
      "properties": {
        "schemaVersion": {"const": "1.0"},
        "runtime": {"$ref": "#/$defs/runtimeV1"}
      }
    },
    {
      "properties": {
        "schemaVersion": {"const": "1.1"},
        "runtime": {"$ref": "#/$defs/runtimeV1_1"}
      }
    }
  ],
  "$defs": {
    "implementation": {
      "type": "object",
      "required": ["id", "displayName", "version", "engineLineageId", "distribution", "license", "assuranceStatus"],
      "properties": {
        "id": {"type": "string"},
        "displayName": {"type": "string"},
        "version": {"type": "string"},
        "engineLineageId": {"type": "string"},
        "distribution": {"type": "string"},
        "license": {"type": "string"},
        "assuranceStatus": {"type": "string"}
      }
    },
    "runtimeV1": {
      "type": "object",
      "required": ["javaVersion", "javaVendor", "osName", "osVersion", "architecture", "buildProperties"],
      "properties": {
        "javaVersion": {"type": "string"},
        "javaVendor": {"type": "string"},
        "osName": {"type": "string"},
        "osVersion": {"type": "string"},
        "architecture": {"type": "string"},
        "buildProperties": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "runtimeV1_1": {
      "type": "object",
      "required": ["osName", "osVersion", "architecture", "buildProperties"],
      "properties": {
        "javaVersion": {"type": ["string", "null"]},
        "javaVendor": {"type": ["string", "null"]},
        "osName": {"type": "string"},
        "osVersion": {"type": "string"},
        "architecture": {"type": "string"},
        "buildProperties": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "parameterSet": {
      "type": "object",
      "required": ["parameterSet", "securityLevel", "rawPublicKeyBytes", "rawPrivateSeedBytes", "rawPrivateExpandedBytes", "rawSignatureBytes", "capabilities", "representations"],
      "properties": {
        "parameterSet": {"enum": ["ML-DSA-44", "ML-DSA-65", "ML-DSA-87"]},
        "securityLevel": {"type": "integer", "enum": [2, 3, 5]},
        "rawPublicKeyBytes": {"type": "integer", "minimum": 1},
        "rawPrivateSeedBytes": {"type": "integer", "minimum": 1},
        "rawPrivateExpandedBytes": {"type": "integer", "minimum": 1},
        "rawSignatureBytes": {"type": "integer", "minimum": 1},
        "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
        "representations": {"type": "array", "items": {"$ref": "#/$defs/representation"}}
      }
    },
    "capability": {
      "type": "object",
      "required": ["operation", "status", "origin", "evidence"],
      "properties": {
        "operation": {"type": "string", "minLength": 1},
        "status": {"enum": ["supported", "unsupported"]},
        "origin": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "reason": {"type": ["string", "null"]},
        "callSite": {"oneOf": [{"$ref": "#/$defs/callSite"}, {"type": "null"}]}
      }
    },
    "callSite": {
      "type": "object",
      "required": ["sourceFile", "className", "methodName", "lineNumber", "snippet", "highlightLine", "arguments"],
      "properties": {
        "sourceFile": {"type": "string", "minLength": 1},
        "className": {"type": "string", "minLength": 1},
        "methodName": {"type": "string", "minLength": 1},
        "lineNumber": {"type": "integer", "minimum": 1},
        "snippet": {"type": "string", "minLength": 1},
        "highlightLine": {"type": "integer", "minimum": 1},
        "arguments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "value"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "type": {"type": "string", "minLength": 1},
              "value": {"type": "string"}
            }
          }
        },
        "usageExample": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "representation": {
      "type": "object",
      "required": ["kind", "status", "origin"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail", "unsupported"]},
        "byteLength": {"type": ["integer", "null"], "minimum": 0},
        "sha256": {"type": ["string", "null"]},
        "algorithmOid": {"type": ["string", "null"]},
        "parametersAbsent": {"type": ["boolean", "null"]},
        "privateChoice": {"type": ["string", "null"]},
        "origin": {"type": "string", "minLength": 1},
        "reason": {"type": ["string", "null"]}
      }
    },
    "check": {
      "type": "object",
      "required": ["id", "parameterSet", "category", "status", "message"],
      "properties": {
        "id": {"type": "string"},
        "parameterSet": {"type": "string"},
        "category": {"type": "string"},
        "status": {"enum": ["pass", "fail", "error", "skipped", "unsupported"]},
        "message": {"type": "string"}
      }
    },
    "interop": {
      "type": "object",
      "required": ["producer", "consumer", "parameterSet", "mode", "status", "message"],
      "properties": {
        "producer": {"type": "string"},
        "consumer": {"type": "string"},
        "parameterSet": {"type": "string"},
        "mode": {"type": "string"},
        "status": {"enum": ["pass", "fail", "unsupported"]},
        "message": {"type": "string"}
      }
    }
  }
}
